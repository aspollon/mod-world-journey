###################################################################################################
# mod-ageless-sixty
#
# The classes of Conquest of Azeroth end at level 60, so Outland and Northrend - made for 58 to 80 -
# are out of their reach. This module makes the whole world one journey from 1 to 60:
#
#     the old world    zones open from  1 to 35 (instead of 1 to 55)
#     Outland          zones open from 30 to 43 (instead of 58 to 67)
#     Northrend        zones open from 40 to 55 (instead of 68 to 77)
#     raids and heroic dungeons of Outland and Northrend: at 60
#
# Every zone stays open until 60: the open-world scaling of CoA lifts what is below a character to
# that character, as it always does. The order of the zones within each part is the original one.
#
# At every start, before the world reads its data, the levels of creatures and quests in the world
# database are set to their compressed values; their money with them. The originals are kept in two
# tables of the world database (ageless_sixty_creature, ageless_sixty_quest), and an update of the
# database that brings new values is noticed and taken as the new original. The spells of a creature
# hit with the numbers of the level they were made for: their damage is scaled down with the level.
# The entry levels of the instances follow the journey as well.
#
# Not yet part of it: the items of Outland and Northrend still ask for level 61 to 80, and the
# world map of the client still shows the original ranges.
#
# Installed through AFK Realm, the module sets MaxPlayerLevel to 60 in worldserver.conf and the
# highest level of the random bots to 60 in playerbots.conf. Bots above 60 stay where they are until
# the random bots are reset.
###################################################################################################

[worldserver]

#
#    AgelessSixty.Enable
#        Description: The world is one journey from 1 to 60. Switched off, the creatures and quests
#                     get their original levels back at the next start.
#        Default:     1 - Enabled
#                     0 - Disabled

AgelessSixty.Enable = 1

#
#    AgelessSixty.Debug
#        Description: More detail in the log.
#        Default:     0 - Disabled
#                     1 - Enabled

AgelessSixty.Debug = 0
