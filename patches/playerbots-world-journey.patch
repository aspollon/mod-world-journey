+namespace
+{
+    // World Journey (mod-world-journey) writes the levels of its journey into the world database at every start.
+    std::map<std::string, int32> WorldJourneyBotLevels()
+    {
+        std::map<std::string, int32> levels;
+        if (!WorldDatabase.Query("SHOW TABLES LIKE 'journey_bot'"))
+            return levels;
+        if (QueryResult result = WorldDatabase.Query("SELECT `name`, `value` FROM `journey_bot`"))
+            do
+                levels[(*result)[0].Get<std::string>()] = (*result)[1].Get<int32>();
+            while (result->NextRow());
+        return levels;
+    }
+}
