diff --git a/modules/mod-destiny-weaver/src/destiny_weaver_scaling.cpp b/modules/mod-destiny-weaver/src/destiny_weaver_scaling.cpp
index 2c29fda6..9ab46bcb 100644
--- a/modules/mod-destiny-weaver/src/destiny_weaver_scaling.cpp
+++ b/modules/mod-destiny-weaver/src/destiny_weaver_scaling.cpp
@@ -219,9 +219,16 @@ namespace
         Map const* map = creature->GetMap();
         // The viewer's own rule, not the realm's: a level that is told to one client is bounded by
         // nothing, because there is nobody else for a high view to be wrong for.
-        uint8 const level = map->IsNonRaidDungeon() && map->IsRegularDifficulty()
+        bool const dungeon = map->IsNonRaidDungeon() && map->IsRegularDifficulty();
+        uint8 level = dungeon
             ? LocalLevelScaling::ScaleDungeonCreatureLevelForViewer(own, viewer->GetLevel(), offset)
             : LocalLevelScaling::ScaleCreatureLevelForViewer(own, viewer->GetLevel(), offset);
+        // In the open world, a window around the viewer may place the creature instead (World Journey).
+        if (!dungeon && !map->Instanceable())
+            if (LocalLevelScaling::CreatureWindowResolver const window =
+                    LocalLevelScaling::CreatureWindowOwner.load(std::memory_order_relaxed))
+                if (uint8 const placed = window(viewer, creature, own))
+                    level = placed;
         if (level == own)
             return false;               // their version *is* the creature: nothing to virtualise
 
diff --git a/src/server/game/Miscellaneous/LocalLevelScaling.h b/src/server/game/Miscellaneous/LocalLevelScaling.h
index b82e5b3b..1d994102 100644
--- a/src/server/game/Miscellaneous/LocalLevelScaling.h
+++ b/src/server/game/Miscellaneous/LocalLevelScaling.h
@@ -48,12 +48,23 @@ inline std::atomic<std::uint32_t> QuestXpKeepSharePercent{100};
 using QuestScalingResolver = bool (*)(Player const*);
 inline std::atomic<QuestScalingResolver> QuestScalingOwner{nullptr};
 
+/// World Journey: scaling is the realm's, not a choice - every character plays the scaled world.
+#define LOCAL_LEVEL_SCALING_WORLD_JOURNEY 1
+inline std::atomic<bool> ScalingChoiceForced{false};
+
+/// World Journey: where a lifted creature stands for a viewer in the open world - its place in its zone, within a
+/// window around the viewer - instead of all of them at the viewer's level minus the offset. 0 = no opinion.
+using CreatureWindowResolver = std::uint8_t (*)(Player const*, Creature const*, std::uint8_t ownLevel);
+inline std::atomic<CreatureWindowResolver> CreatureWindowOwner{nullptr};
+
 /// The character's own answer, with no realm switch in front of it: whether this character asked
 /// for open-world scaling. The realm switches ask *whether* a character's choice is consulted at
 /// all; this asks *what* it is, and is what the per-viewer combat paths resolve.
 inline bool ScalingChoiceEnabled(Player const* player)
 {
     QuestScalingResolver const owner = QuestScalingOwner.load(std::memory_order_relaxed);
+    if (owner && ScalingChoiceForced.load(std::memory_order_relaxed))
+        return true;
     return owner && owner(player);
 }
 
