+        /// World Journey: a player who chose to go into a dungeon alone is never put together with others, and the
+        /// Dungeon Finder starts his dungeon as soon as it finds one for him alone.
+        void SetSoloQueue(ObjectGuid guid, bool solo)
+        {
+            std::lock_guard<std::mutex> lock(m_SoloLock);
+            if (solo)
+                m_SoloQueue.insert(guid);
+            else
+                m_SoloQueue.erase(guid);
+        }
+        [[nodiscard]] bool IsSoloQueue(ObjectGuid guid)
+        {
+            std::lock_guard<std::mutex> lock(m_SoloLock);
+            return m_SoloQueue.count(guid) != 0;
+        }
 
