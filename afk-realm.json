{
  "about": "Read by AFK Realm (https://github.com/aspollon/AFK-Realm) when it builds the server. Without AFK Realm, apply the patches, set these values by hand and copy the addon into the client: see README.md.",
  "patches": [
    {
      "name": "Bots follow the journey",
      "target": "mod-playerbots",
      "file": "patches/playerbots-world-journey.patch",
      "why": "The random bots take their zone levels, their highest level and their mount levels from World Journey, and keep Outland and Northrend when they stop at 60."
    },
    {
      "name": "The journey in CoA's level scaling",
      "target": "core",
      "file": "patches/core-level-window.patch",
      "why": "CoA scales only the old world and the classic dungeons, inside their original levels. With this change Outland and Northrend scale too, every dungeon is held between its new entry level and 60, lifted creatures keep their place in their zone - from two levels below to two above - and Journey.Scaling.Forced can make scaling the realm's."
    },
    {
      "name": "CoA's lottery links on Windows",
      "target": "core",
      "file": "patches/core-lottery-link.patch",
      "why": "CoA's lottery (mod-coa-lottery, October 2026) misses an include, and the server does not link with Visual Studio. Left out by itself as soon as CoA has the fix."
    },
    {
      "name": "Dungeons alone in the Dungeon Finder",
      "target": "core",
      "file": "patches/core-solo-dungeon-finder.patch",
      "why": "Lets a player choose to go into a dungeon alone (Journey.SoloDungeon.Enable): the Dungeon Finder keeps him apart from the others and starts his dungeon at once. Without the choice it waits for a group of five as always."
    }
  ],
  "settings": [
    {
      "file": "worldserver.conf",
      "key": "MaxPlayerLevel",
      "value": "60",
      "why": "The journey ends at 60, where the classes of Conquest of Azeroth end."
    },
    {
      "file": "worldserver.conf",
      "key": "DungeonFinder.MaxExpansion",
      "value": "2",
      "why": "The Dungeon Finder offers the dungeons of Outland and Northrend too: they are part of the journey."
    },
    {
      "file": "worldserver.conf",
      "key": "Wintergrasp.PlayerMinLvl",
      "value": "60",
      "why": "Wintergrasp opens at the end of the journey."
    },
    {
      "file": "playerbots.conf",
      "key": "AiPlayerbot.RandomBotMaxLevel",
      "value": "60",
      "why": "Random bots end at 60 like the players."
    },
    {
      "file": "destiny_weaver.conf",
      "key": "DestinyWeaver.Scaling.Offset",
      "value": "2",
      "why": "Without the level window, lifted creatures stand two levels below a character instead of three."
    },
    {
      "file": "coa.conf",
      "key": "CoA.CreatureScaling.Enable",
      "value": "0",
      "why": "World Journey sets the difficulty of the journey itself. CoA's own creature multipliers come on top: with them on, creatures of the open world have 2.5 times their health and hit twice as hard. To play that harder world, set CoA.CreatureScaling.Enable = 1 in coa.conf."
    }
  ],
  "client": {
    "addons": [
      "client/AddOns/ZoneLevels"
    ],
    "clearCache": true,
    "patch": {
      "edits": [
